[
  {
    "position": "power",
    "holder": "patient",
    "action": "#register",
    "consequence": {
      "entity": "patient",
      "in": "enrolledPatient"
    }
  },
  {
    "position": "power",
    "holder": "enrolledPatient",
    "action": "#giveExplicitConsent",
    "consequence": {
      "plus": "dataProcessing"
    }
  },
  {
    "compound": "dataProcessing",
    "params": ["medCare", "enrolledPatient", "thirdParties"],
    "content": [
      {
        "position": "power",
        "holder": "medCare",
        "action": "#providePrivacyNotice",
        "consequence": {
          "plus": "d1fulfilled"
        }
      },
      {
        "position": "power",
        "holder": "enrolledPatient",
        "action": "#reportFailureToProvideNotice",
        "consequence": {
          "plus": "d1violated"
        }
      },
      {
        "position": "power",
        "holder": "medCare",
        "action": "#implementDataMinimization",
        "consequence": {
          "plus": "d2fulfilled"
        }
      },
      {
        "position": "power",
        "holder": "enrolledPatient",
        "action": "#reportExcessiveDataCollection",
        "consequence": {
          "plus": "d2violated"
        }
      },
      {
        "position": "power",
        "holder": "medCare",
        "action": "#shareWithThirdParties",
        "consequence": {
          "plus": "sharedPatientData"
        }
      },
      {
        "position": "power",
        "holder": "enrolledPatient",
        "action": "#requestAccess",
        "consequence": {
          "plus": "respondAccessRequest"
        }
      }
    ]
  },
  {
    "compound": "respondAccessRequest",
    "params": ["medCare", "enrolledPatient", "thirdParties"],
    "content": [
      {
        "position": "power",
        "holder": "medCare",
        "action": "#respondToAccessRequest",
        "consequence": {
          "plus": "d3fulfilled"
        }
      },
      {
        "condition": "DateTime.Now > RespondAccessRequest.Created.AddMonths(1)",
        "consequence": {
          "plus": "d3violated"
        }
      }
    ]
  },
  {
    "condition": "sharedPatientData",
    "conclusion": "compianceChecking"
  },
  {
    "compound": "compianceChecking",
    "params": ["medCare", "enrolledPatient", "thirdParties"],
    "content": [
      {
        "position": "power",
        "holder": "thirdParties",
        "action": "#complyWithDPA",
        "consequence": {
          "plus": "d4fulfilled"
        }
      },
      {
        "position": "power",
        "holder": "medCare",
        "action": "#reportDpaNoncompliance",
        "consequence": {
          "plus": "d4violated"
        }
      }
    ]
  },
  {
    "position": "power",
    "holder": "enrolledPatient",
    "action": "#optInReminders",
    "consequence": {
      "plus": "remindersProcessing"
    }
  },
  {
    "condition": "remindersProcessing",
    "conclusion": "sendingReminders"
  },
  {
    "compound": "sendingReminders",
    "params": ["medCare", "enrolledPatient", "thirdParties"],
    "content": [
      {
        "position": "power",
        "holder": "medCare",
        "action": "#sendRemindersCompliantly",
        "consequence": {
          "plus": "d5fulfilled"
        }
      },
      {
        "position": "power",
        "holder": "enrolledPatient",
        "action": "#reportUnauthorizedMarketing",
        "consequence": {
          "plus": "d5violated"
        }
      }
    ]
  },
  {
    "position": "power",
    "holder": "enrolledPatient",
    "action": "#withdrawConsent",
    "consequence": {
      "minus": "dataProcessing"
    }
  }
]
